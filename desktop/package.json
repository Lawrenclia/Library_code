{
  "name": "library-workspace",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "format": "prettier --write src/App.vue src/components/WorkbenchShell.vue src/components/TaskTable.vue src/composables/useWorkbench.ts src/style.css src/lib/utils.ts src/types.ts vite.config.ts components.json tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.0.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
